# Copy to .env and adjust. Defaults work out of the box for local dev.

# Postgres: Spadesys metadata (schema "spadesys") + landed data (schema "raw")
POSTGRES_USER=spadesys
POSTGRES_PASSWORD=spadesys
POSTGRES_DB=spadesys
POSTGRES_PORT=5432

# S3-compatible object storage (MinIO)
S3_ACCESS_KEY=spadesys
S3_SECRET_KEY=spadesys-secret
S3_BUCKET=landing
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# App ports
API_PORT=8000
WEB_PORT=5173

# --- profile: sources ---
MYSQL_ROOT_PASSWORD=spadesys
MYSQL_PORT=3306

# CloudBeaver (web DBeaver, shown on the Databases tab). Admin login for its settings.
CLOUDBEAVER_PORT=8978
CLOUDBEAVER_ADMIN=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=Spadesys1

# --- profile: tools ---
JUPYTER_TOKEN=spadesys
